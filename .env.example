# Local development & Vercel Environment Variables
# On Vercel, set these under Project → Settings → Environment Variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
APP_PASSWORD=choose-a-long-random-password
# Encrypts the API keys saved for organizations (Settings → Organizations). Set it once and never change it:
# keys saved under an old SECRET_KEY can no longer be read. Falls back to APP_PASSWORD when empty.
SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODE=auto
# Optional: Scrape.do token — fetches pages that block the app and adds Google results when search is thin
SCRAPEDO_TOKEN=
# AI: OpenRouter (preferred) — or leave empty and set GEMINI_API_KEY
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.8-flash
# CEREBRAS_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=  SAMBANOVA_API_KEY=  NVIDIA_API_KEY=  GITHUB_MODELS_TOKEN=   (more free tiers)
# ANTHROPIC_API_KEY=         # Claude — planning only (understanding the command, search plan)
# CLAUDE_MODEL=claude-opus-5-5  CLAUDE_EFFORT=medium
# LLM_PAGE_CHARS=20000        # page text sent to the AI per page
# AI_MAX_OUTPUT_TOKENS=3000   # reply cap per AI call
# LLM_PROVIDER=openrouter   # default provider when the page does not choose one

# --- Background workers (worker/worker.py, worker/Dockerfile) ---
# WORKER_SCALE=3              # per-batch limits × 3 on workers (no serverless time limit)
# BROWSER_FETCH=1             # headless Chromium for refused / JavaScript pages (set by the Docker image)
# PROXY_URL=http://user:pass@residential-proxy.example:8000   # residential / rotating proxy for the browser
# BROWSER_CONCURRENCY=3
# --- Local model server (bulk page parsing + embeddings; docker-compose starts Ollama) ---
# LOCAL_LLM_URL=http://localhost:11434/v1/chat/completions
# LOCAL_LLM_MODEL=qwen2.5:3b-instruct
# LOCAL_EMBED_MODEL=nomic-embed-text
# LOCAL_LLM_KEY=             # only if your model server needs a bearer token
# --- Zero-send email verification (port 25 must be open where it runs) ---
# SMTP_VERIFY_FROM=verify@yourcompany.com
# SMTP_HELO_DOMAIN=worker.yourcompany.com
# SMTP_VERIFY_URL=http://your-worker:8025/verify   # for Vercel: a server running `python email_verify.py serve`
# SMTP_VERIFY_TOKEN=
# --- Search / Maps ---
# PINNACLE_API_KEY=  PINNACLE_WABA_NUMBER=919xxxxxxxxx   # WhatsApp (approved templates) — Leads → 📣 Message these leads
# BREVO_API_KEY=  BREVO_SENDER_EMAIL=careers@yourdomain.com  BREVO_SENDER_NAME="Magic Billion Careers"
# SEARXNG_URL=http://localhost:8888   # free self-hosted meta-search (see README “Free search with SearXNG”)
# BRAVE_API_KEY=  SERPER_API_KEY=  SERPAPI_KEY=  GOOGLE_CSE_KEY=  GOOGLE_CSE_CX=  GOOGLE_PLACES_API_KEY=
# VECTOR_MAX_DISTANCE=0.6     # hybrid search: leave out vector matches farther than this (cosine distance)
